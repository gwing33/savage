# ─────────────────────────────────────────────────────────────────────────────
# Mosquitto MQTT Broker — fly.io build
#
# The password file cannot be committed to source (it is generated by
# mosquitto_passwd at runtime from MQTT_USER / MQTT_PASS secrets injected
# via `fly secrets set`).  The docker-entrypoint.sh generates it on every
# container start before handing off to the broker.
# ─────────────────────────────────────────────────────────────────────────────
FROM eclipse-mosquitto:2

USER root

COPY fly.conf           /mosquitto/config/mosquitto.conf
COPY docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh

RUN chmod +x /usr/local/bin/docker-entrypoint.sh \
 && mkdir -p /mosquitto/data /mosquitto/log \
 && chown -R mosquitto:mosquitto /mosquitto

ENTRYPOINT ["/usr/local/bin/docker-entrypoint.sh"]
